{
  "name": "mnemosyne",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source, self-hosted memory layer for LLM harnesses.",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --build --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test",
    "api:dev": "npm run dev --workspace @mnemosyne/api",
    "cli:dev": "npm run dev --workspace @mnemosyne/cli",
    "mcp:dev": "npm run dev --workspace @mnemosyne/mcp",
    "web:dev": "npm run dev --workspace @mnemosyne/web",
    "worker:dev": "npm run dev --workspace @mnemosyne/worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pg": "^8.23.0"
  }
}
