{
  "name": "mnemosyne",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source, self-hosted memory layer for LLM harnesses.",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --build --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:generate": "npm run build && node scripts/generate-openapi.mjs",
    "openapi:check": "npm run build && node scripts/generate-openapi.mjs && git diff --exit-code -- docs/openapi.yaml",
    "e2e:synthetic": "npm run build && node scripts/e2e-synthetic.mjs",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "restore:postgres": "node scripts/restore-postgres.mjs",
    "license:check": "node scripts/license-audit.mjs",
    "eval:local": "npm run build && node scripts/eval-governance.mjs",
    "eval:retrieval": "npm run build && node scripts/eval-retrieval.mjs",
    "eval:all": "npm run build && node scripts/eval-governance.mjs && node scripts/eval-retrieval.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "env:init": "node scripts/bootstrap-local-env.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm run license:check && npm run secret:scan && npm run test",
    "api:dev": "npm run dev --workspace @mnemosyne/api",
    "cli:dev": "npm run dev --workspace @mnemosyne/cli",
    "mcp:dev": "npm run dev --workspace @mnemosyne/mcp",
    "web:dev": "npm run dev --workspace @mnemosyne/web",
    "worker:dev": "npm run dev --workspace @mnemosyne/worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/openapi-core": "^2.54.2",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pg": "^8.23.0"
  }
}
