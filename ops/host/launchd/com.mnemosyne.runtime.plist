<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mnemosyne.runtime</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__REPO__/ops/host/mnemosyne-ensure-runtime.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MNEMOSYNE_REPO</key>
    <string>__REPO__</string>
    <key>MNEMOSYNE_DOCKER_SOCKET</key>
    <string>__DOCKER_SOCKET__</string>
    <key>MNEMOSYNE_RUNTIME_APP</key>
    <string>__RUNTIME_APP__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/mnemosyne-runtime.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/mnemosyne-runtime.error.log</string>
</dict>
</plist>
